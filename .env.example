# Firebase Web App config (from Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side secrets for Cloud Functions. The client receives the Razorpay
# key id from the createRazorpayOrder function response, so no client-side
# Razorpay key is needed. Set these as Firebase secrets (NEVER commit real
# values), e.g. for local emulation use functions/.env:
#   RAZORPAY_KEY_ID=
#   RAZORPAY_KEY_SECRET=
#
# Provision for deploys with:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
