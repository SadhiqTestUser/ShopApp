rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Customization uploads are namespaced by the uploader's uid.
    // Anyone can read (URLs are embedded in orders/product previews),
    // but a user may only write/delete files under their own uid folder.
    match /customization-uploads/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
